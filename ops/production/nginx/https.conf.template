map $http_upgrade $connection_upgrade { default upgrade; '' close; }
resolver 127.0.0.11 valid=10s ipv6=off;
log_format safe '$time_iso8601 $request_method $status $body_bytes_sent $request_time $upstream_status $upstream_response_time';
# Nginx raw error lines can contain credentials in URLs; use the status/timing log.
error_log /dev/null;
server_tokens off;
server {
    access_log /dev/stdout safe;
    error_log /dev/null;
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    access_log /dev/stdout safe;
    error_log /dev/null;
    listen 80;
    server_name ${BE_DOMAIN};
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 308 https://${BE_DOMAIN}$request_uri; }
}
server {
    access_log /dev/stdout safe;
    error_log /dev/null;
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}
server {
    access_log /dev/stdout safe;
    error_log /dev/null;
    listen 443 ssl;
    server_name ${BE_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/${BE_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${BE_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location = /actuator/health { include /etc/nginx/conf.d/proxy.inc; }
    location ^~ /api/v1/ { include /etc/nginx/conf.d/proxy.inc; }
    location = /ws { proxy_read_timeout 3600s; include /etc/nginx/conf.d/proxy.inc; }
    location ^~ /ws/ { proxy_read_timeout 3600s; include /etc/nginx/conf.d/proxy.inc; }
    location ^~ /errors/ { include /etc/nginx/conf.d/proxy.inc; }
    # Includes /admin, debug, docs, Swagger and all other Actuator paths.
    location / { return 404; }
}
